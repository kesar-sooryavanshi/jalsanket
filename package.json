{
  "name": "orbitron-2.0",
  "version": "2.0.0",
  "description": "Jal Sanket 2.0 - Himalayan Glacial Lake Outburst Flood (GLOF) Early-Warning Decision Support System",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:all": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run backend\" \"npm run dev:frontend\"",
    "start": "npm run dev --prefix frontend",
    "backend": "python -m uvicorn backend.main:app --port 8000 --host 127.0.0.1 --reload",
    "test:backend": "python backend/test_backend.py",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
